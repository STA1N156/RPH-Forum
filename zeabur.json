{
    "template": "ZEABUR",
    "services": [
        {
            "name": "rp-forum",
            "template": "GIT",
            "env": {
                "ADMIN_USERNAME": {
                    "default": "admin",
                    "expose": false,
                    "readonly": false
                },
                "ADMIN_PASSWORD": {
                    "default": "${PASSWORD}",
                    "expose": false,
                    "readonly": false
                },
                "JWT_SECRET": {
                    "default": "${PASSWORD}",
                    "expose": false,
                    "readonly": false
                },
                "PORT": {
                    "default": "9191",
                    "expose": false,
                    "readonly": true
                },
                "DATA_DIR": {
                    "default": "/app/data",
                    "expose": false,
                    "readonly": true
                },
                "RESEND_API_KEY": {
                    "default": "",
                    "expose": false,
                    "readonly": false
                },
                "RESEND_FROM": {
                    "default": "noreply@rphub.cn",
                    "expose": false,
                    "readonly": false
                },
                "PUBLIC_BASE_URL": {
                    "default": "",
                    "expose": false,
                    "readonly": false
                },
                "ADMIN_NOTIFICATION_EMAILS": {
                    "default": "",
                    "expose": false,
                    "readonly": false
                },
                "NEWAPI_BASE_URL": {
                    "default": "",
                    "expose": false,
                    "readonly": false
                },
                "NEWAPI_ADMIN_TOKEN": {
                    "default": "",
                    "expose": false,
                    "readonly": false
                },
                "NEWAPI_ADMIN_USER_ID": {
                    "default": "",
                    "expose": false,
                    "readonly": false
                },
                "VIEW_HEAT_ACCOUNT_WINDOW_HOURS": {
                    "default": "24",
                    "expose": false,
                    "readonly": false
                },
                "VIEW_HEAT_ACCOUNT_MAX_PER_ITEM": {
                    "default": "1",
                    "expose": false,
                    "readonly": false
                }
            },
            "ports": [
                {
                    "id": "web",
                    "port": 9191,
                    "type": "HTTP"
                }
            ],
            "volumes": [
                {
                    "id": "data2",
                    "dir": "/app/data"
                }
            ]
        }
    ]
}
